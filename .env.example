# === Self-hosted Umami analytics (Build-Argumente, leer = kein Tracking) ===
# Tracker-Skript, z. B. https://analytics.example.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
# Optional: Host, an den Events gehen (Standard: Herkunft des Skripts)
NEXT_PUBLIC_UMAMI_HOST_URL=
# Website-ID aus Umami (Einstellungen → Websites)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
